-- // INIT
-- ============================================================================
Window:SetIconSize(47)
WindUI:SetTheme("Dark")

WindUI:Notify({
    Title    = "👑 KING AKBAR - VIOLENCE DISTRICT",
    Content  = "UI bersih & fitur lengkap. Tinggal santai!",
    Duration = 5,
})
